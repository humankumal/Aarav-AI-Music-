# ── Gemini / Google AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# ── YouTube OAuth ─────────────────────────────────────────────────────────────
# Path to OAuth client credentials JSON (downloaded from Google Cloud Console)
YOUTUBE_CREDENTIALS_PATH=firebase/youtube_oauth_credentials.json
# Path to stored user OAuth token (generated after first auth flow)
YOUTUBE_TOKEN_PATH=firebase/youtube_token_aarav.json

# ── External AI APIs ──────────────────────────────────────────────────────────
# Music generation: Google Lyria via Vertex AI — uses GOOGLE_CLOUD_PROJECT + GOOGLE_APPLICATION_CREDENTIALS below (no separate key needed)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ── GCP ───────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=firebase/service-account.json

# ── App Config ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
REQUIRE_HUMAN_APPROVAL=true
