# Environment
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/
*.log

# Firebase secrets (never commit)
firebase/service-account.json
firebase/youtube_token_*.json
firebase/youtube_oauth_credentials.json

# Media storage (too large for git)
storage/*/songs/*.mp3
storage/*/videos/*.mp4
storage/*/shorts/*.mp4
storage/*/thumbnails/*.jpg
storage/*/thumbnails/*.png

# Keep draft JSON outputs in git for debugging
!storage/**/*.json

# Runtime smoke test artifacts — regenerated on every test run
storage/pipeline_jobs/
storage/mock_audio/*_normalized.mp3
storage/aarav/songs/*_draft.json
storage/aarohi/songs/*_draft.json
storage/aarav/songs/test_*.json
storage/aarohi/songs/test_*.json
storage/aarav/covers/
storage/aarohi/covers/
storage/aarav/uploads/
storage/aarohi/uploads/
storage/aarav/shorts/
storage/aarohi/shorts/
storage/approvals/
storage/webhooks/
storage/cover_generations/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
